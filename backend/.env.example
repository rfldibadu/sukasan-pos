# App Configuration
DEBUG=True
PORT=8000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/sukasan_pos

# Web Push VAPID Keys
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY_PEM="your-vapid-private-key-pem"
VAPID_CLAIM_EMAIL="mailto:admin@example.com"

# Google Gemini AI (Free Tier)
GEMINI_API_KEY="your-google-ai-studio-api-key"
GEMINI_MODEL="gemini-2.5-flash"

# WhatsApp (OpenWA Easy API)
WHATSAPP_PROVIDER="openwa"
OPENWA_BASE_URL="http://localhost:8080"
OPENWA_API_KEY=""
OPENWA_WEBHOOK_SECRET=""

# Delivery Adapter (GrabExpress / GoSend)
DELIVERY_PROVIDER_MODE="sandbox"
BITESHIP_API_KEY=""
STORE_ORIGIN_ADDRESS="Sukasan Coffee"
STORE_ORIGIN_LAT="-8.6500"
STORE_ORIGIN_LNG="115.2167"
